prefix=@RCLIENT_PC_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: rl-c-client
Description: Ratelimitly C client
Version: @PROJECT_VERSION@
Requires.private: libcrypto
Libs: -L${libdir} -lrclient
Libs.private: @RCLIENT_PC_PRIVATE_LIBS@
Cflags: -I${includedir}
